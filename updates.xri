<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p><b>Fluorine7 PixInsight Batch Scripts</b></p>
      <p>V8-compatible batch-processing scripts for PixInsight 1.9.4 and later.</p>
      <p>Repository: https://github.com/Fluorine7/Fluorine7-PixInsight-Scripts</p>
   </description>

   <platform os="all" arch="noarch" version="1.9.4:2.0.0">
      <package fileName="Fluorine7BatchScripts-1.0.0.zip"
               sha1="df62401f3a6b1d8bbf89969b6cc602e2be0eee49"
               type="script"
               releaseDate="20260813">
         <title>Fluorine7 PixInsight Batch Scripts 1.0.0</title>
         <remove>src/scripts/rename_xisf_fits.js</remove>
         <description>
            <p>First combined V8 release for PixInsight 1.9.4 and later.</p>
            <ul>
               <li>Rename By FITS Header 1.2</li>
               <li>Expand Integration 1.3</li>
               <li>Batch Image Keyword Editor 4.0</li>
            </ul>
            <p>All scripts are installed under Script &gt; Batch Processing.</p>
         </description>
      </package>
   </platform>
</xri>
